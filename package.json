{
  "name": "cartel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "turbo run test",
    "bench": "pnpm --filter @cartel/bench bench",
    "bench:publish": "pnpm --filter @cartel/bench bench:publish",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --fail-on warning",
    "db:test": "supabase test db",
    "db:test:integration": "pnpm --filter @cartel/db-tests test:db",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:realtime": "pnpm --filter @cartel/web test:realtime",
    "test:catalog": "node scripts/catalog-smoke.mjs",
    "test:acp-contract": "node scripts/greathub-contract.mjs",
    "ai:smoke": "pnpm --filter @cartel/ai ai:smoke",
    "ai:cost": "pnpm --filter @cartel/ai ai:cost",
    "eval:ai": "pnpm --filter @cartel/ai eval:ai",
    "ai:warm": "pnpm --filter @cartel/ai ai:warm",
    "demo:reset": "node scripts/demo-reset.mjs",
    "photos": "node scripts/product-photos.mjs",
    "demo:check": "node scripts/demo-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "supabase": "2.118.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  },
  "type": "module"
}
