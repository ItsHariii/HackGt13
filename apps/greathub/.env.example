###############################################################################
# GreatHub (apps/greathub)
###############################################################################

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_xxx                # server only; greathub schema

GREATHUB_PUBLIC_ORIGIN=http://localhost:3001    # origin agents sign for and grants are scoped to

CARTEL_BASE_URL=http://localhost:3000
CARTEL_JWKS_URL=http://localhost:3000/.well-known/jwks.json
CARTEL_WEBHOOK_URL=http://localhost:3000/api/webhooks/greathub
CARTEL_WEBAUTHN_ORIGIN=http://localhost:3000  # contract signatures must come from here
CARTEL_WEBAUTHN_RP_ID=localhost
# CARTEL_AGENT_KID_PREFIX=ct-agent-           # key-role binding (defaults shown)
# CARTEL_GRANT_KID_PREFIX=ct-grant-
GREATHUB_WEBHOOK_SECRET=change-me-random        # same value as Cartel web

CHAOS_ADMIN_TOKEN=change-me-random               # protects /chaos and /orders (16+ characters)
ADMIN_TOKEN=change-me-random                     # same value as Cartel web
DEMO_MODE=true                                   # serves the Mock CPSC (demo) feed

PAYMENT_RAIL=visa_acceptance                     # visa_acceptance | simulated (unset: Visa if configured)
VISA_ACCEPTANCE_RUN_ENV=apitest.cybersource.com
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=

SENTRY_DSN=
