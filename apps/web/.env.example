###############################################################################
# Cartel web (apps/web)
###############################################################################

# --- Supabase ---------------------------------------------------------------
# Local: values printed by `supabase start`. Cloud: Project Settings -> API Keys.
# Use the new keys (sb_publishable_ / sb_secret_), not legacy anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx                # server only, never NEXT_PUBLIC_

# --- AI (OpenAI primary, Meta Model API fallback) ---------------------------
# Server-only. Set a hard monthly spend limit on the OpenAI project and on the
# Meta developer account. Model IDs verified 2026-09-26; confirm with
# `GET /v1/models` after adding a key. See docs/SDD.md §10.4 for the budget.
AI_ENABLED=true                                  # false = "AI off" mode (forms only)
AI_PROVIDER=openai                               # openai | meta
AI_FALLBACK_PROVIDER=meta                        # used on 429/5xx/timeout; empty = no fallback

OPENAI_API_KEY=sk-proj-xxx
# Demo values. For day-to-day testing set both to gpt-6-luna.
OPENAI_MODEL_PRIMARY=gpt-6-sol                   # A1 brief, A2 roles, A4 refinements
OPENAI_MODEL_FAST=gpt-6-luna                     # A3 extraction, A5 explanations
OPENAI_REASONING_EFFORT=low                      # none | low | medium

# Meta Model API (Muse Spark), OpenAI-compatible Chat Completions endpoint.
META_MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_PRIMARY=muse-spark-1.3
# muse-spark-1.3-contributor is ~10x cheaper, but Meta may train on prompts and
# completions. Use it only for synthetic test data (ProofBench, CI evals).
META_MODEL_FAST=muse-spark-1.3

# --- WebAuthn contract signing ---------------------------------------------
# RP ID must be the stable production domain (previews won't match).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Cartel
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Agent identity (RFC 9421 / TAP) and scoped payment grants ---------------
# Generate with: pnpm tsx scripts/gen-keys.ts  (Ed25519 private JWKs, one line JSON)
AGENT_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","d":"xxx","x":"xxx","kid":"ct-agent-2026-09"}
AGENT_KEY_ID=ct-agent-2026-09
GRANT_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","d":"xxx","x":"xxx","kid":"ct-grant-2026-09"}
GRANT_KEY_ID=ct-grant-2026-09
# Optional previous keys kept in JWKS during rotation (same JWK shape).
# AGENT_SIGNING_JWK_PREVIOUS=
# AGENT_KEY_ID_PREVIOUS=
# GRANT_SIGNING_JWK_PREVIOUS=
# GRANT_KEY_ID_PREVIOUS=

# --- Internal worker (pg_cron -> pg_net -> /api/internal/queue/*) -----------
# Must match the Supabase Vault secret `worker_hmac_secret`.
INTERNAL_QUEUE_HMAC_SECRET=change-me-32-bytes-random
# Shared with GreatHub so its Chaos Panel can call "Run mandate tick now".
ADMIN_TOKEN=change-me-random

# --- GreatHub (test merchant) -----------------------------------------------
CARTEL_JWKS_URL=http://localhost:3000/.well-known/jwks.json
GREATHUB_BASE_URL=http://localhost:3001
GREATHUB_WEBHOOK_SECRET=change-me-random        # same value in GreatHub

# --- Payments ---------------------------------------------------------------
PAYMENT_RAIL=visa_acceptance                     # visa_acceptance | vic | authorize_net | simulated

# Visa Acceptance (Cybersource) sandbox
VISA_ACCEPTANCE_RUN_ENV=apitest.cybersource.com
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=

# Visa Intelligent Commerce (only if Visa provides credentials)
VIC_API_KEY=
VIC_SHARED_SECRET=
VIC_ENCRYPTION_KEY_ID=
VIC_ENCRYPTION_CERT=
VIC_TOKEN_REQUESTOR_ID=

# Authorize.net sandbox (fallback rail)
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=
NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=

# --- Catalog sources --------------------------------------------------------
SOURCES_ENABLED=shopify,icecat,upcitemdb,greathub   # per-source kill switch (Best Buy: no access)
SHOPIFY_AGENT_PROFILE_URL=http://localhost:3000/.well-known/ucp-agent   # confirm path in Shopify docs
ICECAT_USERNAME=
ICECAT_API_TOKEN=
# UPCitemdb: keyless trial (100 req/day per IP) when empty; a paid key switches
# to /prod/v1. Cache every lookup in Supabase; offers carry their last-seen time.
UPCITEMDB_USER_KEY=
OFF_USER_AGENT="Cartel/1.0 (team contact email)"   # Open Food Facts (stretch)
EBAY_CLIENT_ID=                                  # optional; only if partner access is granted
EBAY_CLIENT_SECRET=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                               # CI source-map upload only
LOG_LEVEL=info
# Phase 13 checkout (server-owned origins; no trailing slash)
CARTEL_BASE_URL=http://localhost:3000
SHOPIFY_HANDOFF_ORIGINS=
SHOPIFY_ACCESS_TOKEN=
