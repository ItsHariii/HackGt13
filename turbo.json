{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": [
        "NEXT_PUBLIC_*",
        "SENTRY_*",
        "SUPABASE_*",
        "AGENT_*",
        "CARTEL_*",
        "LOG_LEVEL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "@cartel/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@cartel/greathub#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "SUPABASE_*",
    "SENTRY_*",
    "AGENT_*",
    "CARTEL_*",
    "GREATHUB_*",
    "LOG_LEVEL"
  ],
  "globalPassThroughEnv": ["UNSPLASH_ACCESS_KEY"]
}
